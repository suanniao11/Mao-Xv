# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose ONE provider and fill in the relevant keys.
# Set LLM_PROVIDER to: openai | azure | anthropic
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── External APIs ─────────────────────────────────────────────────────────────
# Google Maps Platform (or compatible) — https://console.cloud.google.com/
MAP_API_KEY=
MAP_API_BASE_URL=https://maps.googleapis.com/maps/api

# OpenWeatherMap — https://home.openweathermap.org/api_keys
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ── Agent Tuning ──────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=true
